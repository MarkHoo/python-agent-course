# ---- 复制为 .env 后填写，.env 绝不提交 git ----

# 大模型（OpenAI 兼容端点；示例为阿里百炼 DashScope）
OPENAI_API_KEY=sk-你的key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-coder-turbo

# 运行参数
TEMPERATURE=0
REQUEST_TIMEOUT=60
MAX_RETRIES=2
LOG_LEVEL=INFO

# 服务监听（第 20/27 章的 HTTP 服务；命令行参数优先于这里）
HOST=127.0.0.1
PORT=8000

# 离线模式：设为 1 时不访问真实模型，用 EchoChatModel 走通链路（无需 Key）
OFFLINE=0

# ---- 以下按需启用（对应章节会提示） ----
MILVUS_URI=http://localhost:19530
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/agent_course
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j1234
ELASTICSEARCH_URL=http://localhost:9200
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 观测
LANGSMITH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
