# 生产环境变量样例（复制为 .env.prod；由 compose 的 env_file 注入，不进镜像层）
APP_ENV=prod
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SHUTDOWN_GRACE=10

# 数据卷根目录（生产一般指向独立数据盘）
DOCKER_VOLUME_DIRECTORY=/data/agent-course

# 数据库（容器内用服务名 mysql-prod，不要用 localhost）
MYSQL_DATABASE=book
MYSQL_ROOT_PASSWORD=change-me-please
DATABASE_URL=mysql://root:change-me-please@mysql-prod:3306/book

# 大模型密钥：生产环境建议改用密钥管理服务，而不是明文 .env
MODEL_NAME=qwen-plus
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=change-me-please
